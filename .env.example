# Cloudflare Pages > Settings > Variables and Secrets > Production and Preview.
# Set the final public https:// origin, then rebuild. Never include a path.
# If empty, canonical/hreflang are omitted and robots prevent indexing.
NEXT_PUBLIC_SITE_URL=
# Defaults to the Git production branch main; change if you use another branch.
PRODUCTION_BRANCH=main
# Optional override for manual/local builds: production or preview.
SITE_ENV=
# Optional Google Analytics 4 measurement ID. Read at build time; rebuild after changes.
# Leave empty to disable Analytics for all locales.
NEXT_PUBLIC_GA_ID=
